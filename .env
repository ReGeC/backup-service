# Бэкап PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=yourpass
PG_DATABASE=mydb

# Бэкап SQLite
SQLITE_PATH=/path/to/db.sqlite

# Хранилище
BACKUP_STORAGE=local
BACKUP_TEMP_PATH=./tmp/backups
BACKUP_RETENTION_DAYS=7
PG_ENABLE=FALSE
SQLITE_ENABLE=TRUE

# LocalStorage
LOCAL_STORAGE_PATH=./backups

# ЯндексS3
YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net
YANDEX_S3_BUCKET=my-backups
YANDEX_S3_REGION=ru-central1
YANDEX_S3_KEY=your_access_key
YANDEX_S3_SECRET=your_secret_key

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_CHAT_ID=123456

# Расписание (крон-строка)
CRON_ENABLE=FALSE
CRON_SCHEDULE="0 3 * * *"  # каждый день в 3:00