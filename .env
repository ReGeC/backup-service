# Бэкап PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=yourpass
PG_DATABASE=mydb

# Бэкап SQLite
SQLITE_PATH=/path/to/db.sqlite

# Хранилище
BACKUP_STORAGE=local
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7
PG_ENABLE=FALSE
SQLITE_ENABLE=TRUE

# S3
S3_BUCKET=my-backups
S3_REGION=ru-central1
S3_KEY=your_key
S3_SECRET=your_secret

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_CHAT_ID=123456

# Расписание (крон-строка)
BACKUP_SCHEDULE="0 3 * * *"  # каждый день в 3:00